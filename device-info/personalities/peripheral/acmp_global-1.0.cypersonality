<Personality id="psc1_acmp_global" name="ACMP Global" version="1.0" xmlns="http://cypress.com/xsd/cyhwpersonality_v7">
  <Dependencies>
    <IpBlock name="psc1_acmp" />
    <Resource name="acmp" />
  </Dependencies>
  <ExposedMembers />
  <Parameters>
    <ParamString id="InstNumber" name="" group="Internal" default="`${getInstNumber(&quot;acmp&quot;)}`" visible="false" editable="false" desc="" />

    <ParamDoc id="apiDoc" name="API Help" group="Documentation" default="file:///`${cy_libs_path()}`/docs/Cy_api_reference_manual/html/group___a_c_m_p.html" linkText="Open ACMP Driver Documentation" visible="true" desc="Opens the PSC1 Peripheral Library Documentation" />

    <!-- Power Mode Selection -->
    <ParamBool id="acmp_power_mode_select" name="Low Power Mode" group="Power Mode Selection" default="false" visible="true" editable="true" desc="Configures the analog comparator to operate in low power mode." />

  </Parameters>
  <DRCs />
  <ConfigFirmware>
    <ConfigInstruction value="Cy_ACMP_ClearLowPowerMode();" include="`${!acmp_power_mode_select}`" />
    <ConfigInstruction value="Cy_ACMP_SetLowPowerMode();" include="`${acmp_power_mode_select}`" />
  </ConfigFirmware>
</Personality>
